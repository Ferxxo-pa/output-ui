NODE_ENV=development
PORT=5000

# Saved clock, wages, collected money, and company. Defaults to ./data
# DATA_DIR=./data

# One paid hour, in milliseconds. Defaults to a real hour (3600000).
# HOUR_DURATION_MS=3600000

# OUTPUT live API base. Leave unset to use the labeled demo fixture.
# Setting this does not invent endpoints: live mode fails closed until Ez Ink wires the port.
# VITE_OUTPUT_API_BASE=
